{
  "name": "ritim",
  "version": "1.0.0",
  "private": true,
  "description": "A mobile-first recurring task and medication tracker. Single HTML file, installable as a PWA, with an optional Node.js server for syncing between devices.",
  "license": "MIT",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "test": "node --test tests/api.test.js && node tests/e2e.js",
    "test:api": "node --test tests/api.test.js",
    "test:e2e": "node tests/e2e.js",
    "test:sync": "node tests/sync.js",
    "icons": "node scripts/make-icons.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  },
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2"
  }
}
